# ═══════════════════════════════════════════════════════════
# SoloForte — Variáveis de Ambiente (Template)
# ═══════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha com valores reais.
# NUNCA commite .env.local — ele contém chaves sensíveis.

# ───────────────────────────────────────────────────────────
# SUPABASE
# ───────────────────────────────────────────────────────────
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua_chave_anon_aqui

# ───────────────────────────────────────────────────────────
# STADIA MAPS (Tile Provider do Mapa Padrão)
# ───────────────────────────────────────────────────────────
# Obter chave gratuita em: https://client.stadiamaps.com/signup/
# Free tier: 20k tiles/dia sem custo
STADIA_API_KEY=sua_chave_stadia_aqui

# ───────────────────────────────────────────────────────────
# OUTRAS CHAVES / SATÉLITE NDVI
# ───────────────────────────────────────────────────────────
PLANET_API_KEY=sua_chave_planet_aqui
PLANET_API_SECRET=seu_secret_planet_aqui
# NDVI real (colormap) exige OAuth Sentinel Hub — NÃO use só WMS Instance ID.
# Crie em https://apps.sentinel-hub.com/ → OAuth client → client_id + client_secret
SENTINEL_HUB_CLIENT_ID=seu_oauth_client_id
SENTINEL_HUB_CLIENT_SECRET=seu_oauth_client_secret
# Legado / aliases usados pela edge ndvi-fetch se CLIENT_* ausentes:
SENTINEL_API_USER_ID=seu_oauth_client_id
SENTINEL_API_TOKEN=seu_oauth_client_secret
# Token estático (opcional); catalog/process exigem Bearer OAuth na maioria das contas
SENTINEL_HUB_TOKEN=
CDSE_CLIENT_ID=sh-seu_oauth_client_id
CDSE_CLIENT_SECRET=seu_oauth_client_secret_cdse
NDVI_SENTINEL_PROVIDER=cdse
